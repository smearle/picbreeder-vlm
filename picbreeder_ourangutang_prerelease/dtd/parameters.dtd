<!ELEMENT data (parameters)>
<!ATTLIST data version CDATA #REQUIRED>

<!ELEMENT parameters (set | group)*>

<!ELEMENT set (item+)>
<!ATTLIST set name CDATA #REQUIRED>

<!ELEMENT item EMPTY>
<!ATTLIST item
	value CDATA #REQUIRED
	weight 1.0
>

<!ELEMENT group (parameter+)>
<!ATTLIST group name CDATA #REQUIRED>

<!ELEMENT parameter EMPTY>
<!ATTLIST parameter
	name CDATA #REQUIRED
	value CDATA #REQUIRED
>
