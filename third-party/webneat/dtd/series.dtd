<!ELEMENT data (parameters?, series)>
<!ATTLIST data
	version CDATA #REQUIRED
	date CDATA #IMPLIED
>

<!ELEMENT parameters EMPTY>

<!ELEMENT series (branchFrom?, generation+)>
<!ATTLIST series branch CDATA #REQUIRED>

<!ELEMENT branchFrom EMPTY>
<!ATTLIST branchFrom
	branch CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT generation EMPTY>
<!ATTLIST generation
	number CDATA #REQUIRED
	storage CDATA #REQUIRED
>
