<project>
    
    <property name="lib.dir" value="lib"/>
    <!-- Default main class was the legacy Applet. For running as a standalone desktop app
	    we switch to client.gui.MainWindow which provides a proper public static void main. -->
    <property name="main-class"  value="client.gui.MainWindow"/>
    <property name="build.dir"   value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="jar.dir" value="jar"/>

    <path id="classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
        <pathelement path="."/>
    </path>

    <target name="clean">
        <delete dir="build"/>
    </target>

	<target name="compile">
		<mkdir dir="build/classes"/>
		<!-- Modernize compilation target so it works on current JDKs (1.5 no longer supported). -->
		<javac sourcepath="" srcdir="." includes="**/*.java" destdir="build" classpathref="classpath" source="1.8" target="1.8" fork="yes" includeantruntime="false"/>
	</target>

    <target name="generatekey">
    	<genkey alias="eplex" storepass="cppn06">
		<dname>
			<param name="CN" value="The Evolutionary Complexity Group"/>
			<param name="OU" value="The Evolutionary Complexity Group"/>
			<param name="O" value="University of Central Florida"/>
			<param name="C" value="US"/>
		</dname>
	</genkey>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${jar.dir}"/>
        
	<jar destfile="${jar.dir}/client.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main-class}"/>
            </manifest>
        </jar>

	<!--<signjar jar="${jar.dir}/client.jar" alias="eplex" storepass="cppn06"/>-->

        <exec executable="jar" dir="${jar.dir}">
		<arg value="xvf"/>
		<arg value="../${lib.dir}/ksoap2-j2se-full-2.1.1.jar"/>
	</exec>
        
        <exec executable="jar" dir="${jar.dir}">
		<arg value="xvf"/>
		<arg value="../${lib.dir}/jlfgr-1_0.jar"/>
	</exec>
	
	<exec executable="jar" dir="${jar.dir}">
		<arg value="uf"/>
		<arg value="client.jar"/>
		<arg value="org"/>
	</exec>
        <exec executable="jar" dir="${jar.dir}">
		<arg value="uf"/>
		<arg value="client.jar"/>
		<arg value="paletteButtonGraphics"/>
	</exec>
        <exec executable="jar" dir="${jar.dir}">
		<arg value="uf"/>
		<arg value="client.jar"/>
		<arg value="toolbarButtonGraphics"/>
	</exec>
        <exec executable="jar" dir="${jar.dir}">
		<arg value="uf"/>
		<arg value="client.jar"/>
		<arg value="treeIcons"/>
	</exec>
    </target>

    <target name="install">
    	<copy file="${jar.dir}/client.jar" todir="/var/www/webneat/user"/>
    </target>

    <target name="run">
        <java jar="jar/client.jar" fork="true" classpathref="classpath"/>
    </target>

</project>
